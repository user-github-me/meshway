<Window x:Class="Meshway.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Meshway" Width="920" Height="820" MinWidth="720" MinHeight="640" Background="#F5F7FA" Closing="OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="Meshway" FontSize="32" FontWeight="Bold" />
      <TextBlock Text="Your open peer network" Foreground="#586575" Margin="0,4,0,20" />
      <TextBlock x:Name="StateText" Text="Daemon offline" FontSize="18" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText" Text="Add a bootstrap peer or connect an address to join your network." TextWrapping="Wrap" Margin="0,8,0,12" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button x:Name="StartButton" Content="Start" Click="StartClicked" Padding="18,8" Margin="0,0,8,0" />
        <Button x:Name="StopButton" Content="Stop" Click="StopClicked" Padding="18,8" Margin="0,0,8,0" IsEnabled="False" />
        <Button Content="Refresh" Click="RefreshClicked" Padding="18,8" />
      </StackPanel>
      <GroupBox Header="Connection mode" Padding="12" Margin="0,0,0,18">
        <StackPanel>
          <ComboBox x:Name="ConnectionMode" SelectedIndex="0" SelectionChanged="ConnectionModeChanged" Margin="0,0,0,10">
            <ComboBoxItem Content="VPN · protect all apps" />
            <ComboBoxItem Content="SOCKS · connect chosen apps" />
            <ComboBoxItem Content="Personal tunnel · use your own server" />
          </ComboBox>
          <TextBlock x:Name="ModeDescription" Text="VPN routes IPv4, IPv6 and DNS through an approved server. Choose a server below to connect; Windows asks for administrator consent." TextWrapping="Wrap" Foreground="#586575" />
          <TextBlock x:Name="ConnectionSummary" Text="Start Meshway to see live connection status." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0" />
          <TextBlock x:Name="TrafficSummary" Text="Traffic: —" TextWrapping="Wrap" Foreground="#586575" Margin="0,8,0,0" />
        </StackPanel>
      </GroupBox>
      <Expander Header="Connection details" Margin="0,0,0,18"><TextBox x:Name="StatusText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="110" /></Expander>
      <GroupBox x:Name="TunnelPanel" Header="Personal server connection" Padding="12" Margin="0,0,0,18" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Your personal server accepts devices enrolled with your recovery key. Choose it below to connect the Meshway SOCKS proxy. SSH is a transport to that same Meshway server; device VPN capture is a separate choice." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <CheckBox x:Name="PersonalDeviceVPN" Content="Protect all apps through your personal server" IsChecked="True" Margin="0,0,0,10" />
          <CheckBox x:Name="UseSSH" Content="Wrap the Meshway connection in SSH" Margin="0,0,0,10" />
          <TextBlock Text="SSH host alias from your existing OpenSSH configuration" /><TextBox x:Name="SSHAlias" Margin="0,4,0,8" />
          <TextBlock Text="Your server's pinned Meshway peer ID" /><TextBox x:Name="SSHPeer" Margin="0,4,0,8" />
          <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Left" Width="250"><TextBlock Text="Local loopback port" /><TextBox x:Name="SSHLocalPort" Text="44001" Margin="0,4,12,0" /></StackPanel><StackPanel><TextBlock Text="Server loopback Meshway port" /><TextBox x:Name="SSHRemotePort" Text="44001" Margin="0,4,0,0" /></StackPanel></DockPanel>
          <Button x:Name="SaveSSHButton" Content="Save personal transport" Click="SaveSSHClicked" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,10" />
          <TextBlock x:Name="TransportSummary" Text="Direct Meshway transport" TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <TextBlock Text="SSH uses your system OpenSSH, existing agent/configuration and verified known host. Stop Meshway before saving. Passwords and private keys are never entered here. This build uses SOCKS capture with SSH; full-device SSH VPN requires an additional endpoint bypass." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <Expander Header="Advanced tools · TCP service tunnels">
          <StackPanel>
          <TextBlock Text="Open a local port to a named service shared by a trusted peer. Tunnels start with Meshway; they do not change this device's VPN or DNS." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <StackPanel x:Name="TunnelList" />
          <TextBlock Text="Tunnel name" /><TextBox x:Name="TunnelName" Text="my-service" Margin="0,4,0,8" />
          <TextBlock Text="Local listener" /><TextBox x:Name="TunnelListen" Text="127.0.0.1:8081" Margin="0,4,0,8" />
          <TextBlock Text="Server peer ID" /><TextBox x:Name="TunnelPeer" Margin="0,4,0,8" />
          <TextBlock Text="Shared service name" /><TextBox x:Name="TunnelService" Text="web" Margin="0,4,0,8" />
          <Button x:Name="AddTunnelButton" Content="Save tunnel" Click="AddTunnelClicked" HorizontalAlignment="Left" Padding="14,7" />
          <TextBlock Text="Stop Meshway before changing tunnels. Ask the server owner for the service name and approval; saved listeners appear here after starting." TextWrapping="Wrap" Foreground="#586575" Margin="0,10,0,0" />
          </StackPanel>
          </Expander>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Servers" Padding="12" Margin="0,0,0,18">
        <StackPanel>
          <TextBlock x:Name="CatalogMessage" Text="Start Meshway to see available servers." Foreground="#586575" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Button Content="Disconnect" Click="DisconnectClicked" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,12" />
          <StackPanel x:Name="ServerList" />
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Add a server invitation" Padding="12" Margin="0,0,0,18">
        <StackPanel>
          <TextBox x:Name="ConnectAddress" ToolTip="Paste the invitation address from a server owner" Margin="0,0,0,8" />
          <Button Content="Add server" Click="ConnectClicked" HorizontalAlignment="Left" Padding="18,7" />
          <TextBlock Text="The owner needs to approve this device before you can use its exit or tunnels." Foreground="#586575" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </GroupBox>
      <Expander x:Name="SettingsGroup" Header="Advanced node settings · apply on next start" Padding="12">
        <StackPanel>
          <TextBlock Text="Daemon executable" />
          <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Choose…" Click="ChooseClicked" Margin="8,0,0,0" Padding="12,3" /><TextBox x:Name="ExecutablePath" /></DockPanel>
          <TextBlock Text="State directory" /><TextBox x:Name="StateDirectory" Margin="0,4,0,12" />
          <TextBlock Text="SOCKS listener (empty disables)" /><TextBox x:Name="SocksListen" Margin="0,4,0,12" />
          <TextBlock Text="Loopback API listener" /><TextBox x:Name="ApiListen" Margin="0,4,0,12" />
          <TextBlock Text="Local API token" /><PasswordBox x:Name="ApiToken" Margin="0,4,0,12" />
          <TextBlock Text="Upstream exit peer ID (optional)" /><TextBox x:Name="UpstreamPeer" Margin="0,4,0,12" />
          <TextBlock Text="Bootstrap multiaddresses · one per line" /><TextBox x:Name="BootstrapPeers" AcceptsReturn="True" MinHeight="65" Margin="0,4,0,12" />
          <TextBlock Text="Allowed inbound peer IDs · one per line" /><TextBox x:Name="AllowedPeers" AcceptsReturn="True" MinHeight="55" Margin="0,4,0,8" />
          <TextBlock Text="An empty allowlist denies inbound tunnels and exit requests. Add trusted peer IDs before sharing access." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,14" />
          <CheckBox x:Name="RelayRole" Content="Serve encrypted relay traffic" Margin="0,0,0,10" />
          <CheckBox x:Name="PersonalServer" Content="Use as your private server" Checked="PersonalServerChanged" Unchecked="PersonalServerChanged" Margin="0,0,0,8" />
          <TextBlock Text="Your private server accepts devices enrolled with the same recovery key. Save your recovery file, then import it on your own server. Keep it private." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <CheckBox x:Name="ExitRole" Content="Serve as an internet exit" Checked="ExitChanged" Unchecked="ExitChanged" Margin="0,0,0,8" />
          <TextBlock Text="Exit traffic uses your public IP address and bandwidth. Enable only if you intend to forward peers' internet traffic." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <CheckBox x:Name="PrivateTargets" Content="Allow exits to reach private / LAN destinations" IsEnabled="False" Margin="0,0,0,14" />
          <Button Content="Save settings" Click="SaveClicked" HorizontalAlignment="Left" Padding="18,7" />
        </StackPanel>
      </Expander>
      <GroupBox Header="Local account and devices" Padding="12" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="Your recovery key identifies your account. Devices have separate peer identities. History stays local unless account sync is enabled and requested." TextWrapping="Wrap" Foreground="#586575" Margin="0,0,0,12" />
          <Button Content="Refresh account" Click="AccountClicked" HorizontalAlignment="Left" Padding="14,7" />
          <TextBox x:Name="AccountText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="300" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,12,0,12" />
          <TextBlock Text="Account peer ID for optional sync" /><TextBox x:Name="AccountSyncPeer" Margin="0,4,0,8" />
          <Button Content="Sync with peer" Click="AccountSyncClicked" HorizontalAlignment="Left" Padding="14,7" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Save recovery key…" Click="ExportRecoveryClicked" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Import recovery key…" Click="ImportRecoveryClicked" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Replace recovery key…" Click="RotateRecoveryClicked" Padding="14,7" />
          </StackPanel>
          <TextBlock Text="Device peer ID to revoke" Margin="0,12,0,4" /><TextBox x:Name="RevokePeer" />
          <Button Content="Revoke device…" Click="RevokeDeviceClicked" HorizontalAlignment="Left" Padding="14,7" Margin="0,8,0,12" />
          <CheckBox x:Name="SyncHistoryDeletion" Content="Apply history deletion to synced devices" IsChecked="True" />
          <Button Content="Delete connection history…" Click="ClearHistoryClicked" HorizontalAlignment="Left" Padding="14,7" Margin="0,8,0,0" />
          <TextBlock Text="Stop Meshway before saving or importing. Anyone with this recovery file can enroll devices in your account. Keep the backup private." TextWrapping="Wrap" Foreground="#586575" Margin="0,10,0,0" />
        </StackPanel>
      </GroupBox>
      <Button Content="Open configuration folder" Click="OpenFolderClicked" HorizontalAlignment="Left" Margin="0,16,0,12" />
      <TextBlock Text="Device VPN protects IPv4, IPv6, and DNS through Wintun. Windows requests administrator consent when applying routes and firewall protection. SOCKS mode connects individual applications." TextWrapping="Wrap" Foreground="#586575" />
    </StackPanel>
  </ScrollViewer>
</Window>

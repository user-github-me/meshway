{
  "manifest_version": 2,
  "name": "Meshway — Local Browser Proxy",
  "version": "0.1.0",
  "description": "Opt in to route browser TCP traffic through your local Meshway SOCKS5 daemon. This is a browser proxy, not a device-wide VPN.",
  "permissions": ["proxy", "storage"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html", "default_title": "Meshway browser proxy", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "meshway-local-proxy@meshway.local", "strict_min_version": "109.0", "data_collection_permissions": { "required": ["none"] } } },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
